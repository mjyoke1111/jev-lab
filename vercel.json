{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/|runs/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/arena",
      "destination": "/projects/agent-safety-arena",
      "permanent": true
    },
    {
      "source": "/rerank",
      "destination": "/projects/semantic-rerank",
      "permanent": true
    },
    {
      "source": "/gate",
      "destination": "/projects/action-gate",
      "permanent": true
    },
    {
      "source": "/experiments/content-firewall",
      "destination": "/projects/content-firewall",
      "permanent": true
    }
  ]
}
